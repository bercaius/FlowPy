/* FlowPy Professional Light Theme - Tier 1 IDE
   Color System:
   - Background: #ffffff (deep), #f3f3f3 (surface), #e5e5e5 (elevated)
   - Text: #1a1a1a (primary), #444444 (secondary), #666666 (tertiary)
   - Accent: #0078d4 (professional blue)
   - Success: #107c10
   - Warning: #f59e0b
   - Error: #dc2626
   - Border: #d1d1d1
*/

* {
    background: transparent;
    color: #444444;
    font-family: "Segoe UI", "Segoe UI Variable", "Inter", "SF Pro Text", system-ui, sans-serif;
    font-size: 13px;
    outline: none;
}

QWidget {
    background-color: #ffffff;
    color: #444444;
}

QMainWindow, QDialog {
    background-color: #ffffff;
}

/* ---- Title Bar ---- */
TitleBar {
    background-color: #f3f3f3;
    border-bottom: 1px solid #d1d1d1;
    min-height: 40px;
    max-height: 40px;
}

QLabel#AppTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    padding-left: 12px;
    letter-spacing: 0.3px;
}

QPushButton#TitleBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    color: #444444;
    font-weight: 500;
    font-size: 12px;
}
QPushButton#TitleBtn:hover { background-color: #e5e5e5; color: #1a1a1a; }
QPushButton#CloseBtn:hover { background-color: #dc2626; color: #ffffff; }

QLineEdit#SearchInput {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 16px;
    padding: 5px 14px;
    color: #1a1a1a;
    font-size: 12px;
    min-width: 240px;
    max-width: 320px;
}
QLineEdit#SearchInput:focus {
    border: 1px solid #0078d4;
    background-color: #f9f9f9;
}
QLineEdit#SearchInput::placeholder {
    color: #888888;
}

/* ---- Sidebar ---- */
SideBar {
    background-color: #f3f3f3;
    border-right: 1px solid #d1d1d1;
    min-width: 72px;
    max-width: 72px;
}

QPushButton#NavBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: #444444;
    min-width: 56px;
    min-height: 40px;
}
QPushButton#NavBtn:hover { 
    background-color: #e5e5e5; 
    color: #1a1a1a; 
}
QPushButton#NavBtn[active="true"] {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    color: #0078d4;
    font-weight: 600;
}
QLabel#NavLabel {
    color: #444444;
    font-size: 10px;
    font-weight: 500;
    padding: 0 2px;
}
QPushButton#NavBtn[active="true"] + QLabel#NavLabel {
    color: #0078d4;
    font-weight: 600;
}

/* ---- Toolbar ---- */
QToolBar {
    background-color: #f3f3f3;
    border-bottom: 1px solid #d1d1d1;
    spacing: 4px;
    padding: 4px 12px;
}

QPushButton#ToolBtn {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 5px 12px;
    color: #444444;
    font-weight: 500;
    font-size: 12px;
    min-height: 28px;
}
QPushButton#ToolBtn:hover { 
    background-color: #e5e5e5; 
    border-color: #0078d4; 
    color: #1a1a1a; 
}
QPushButton#ToolBtn:pressed { 
    background-color: #d1d1d1; 
    border-color: #0078d4;
}
QPushButton#ToolBtn:disabled { 
    color: #888888; 
    background-color: #f9f9f9;
}

QPushButton#PrimaryBtn {
    background-color: #0078d4;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    min-height: 28px;
}
QPushButton#PrimaryBtn:hover { 
    background-color: #1a8ad4; 
    border: 1px solid #4eb0f5;
}
QPushButton#PrimaryBtn:pressed { 
    background-color: #0066b8; 
}

QPushButton#RunBtn {
    background-color: #107c10;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    min-height: 28px;
}
QPushButton#RunBtn:hover { 
    background-color: #0b8a0b; 
}
QPushButton#RunBtn:pressed { 
    background-color: #0a6b0a; 
}

/* ---- Editor ---- */
QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    font-family: "Cascadia Code", "Consolas", "Courier New", "Fira Code", monospace;
    font-size: 14px;
    line-height: 1.5;
    selection-background-color: #add6ff;
    selection-color: #1a1a1a;
}

LineNumberArea {
    background-color: #f3f3f3;
    color: #666666;
    border: none;
    border-right: 1px solid #d1d1d1;
}

/* ---- Flowchart ---- */
QGraphicsView {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #f3f3f3;
    border-top: 1px solid #d1d1d1;
    color: #444444;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 500;
}
QStatusBar::item { border: none; }

QLabel#Stat {
    color: #1a1a1a;
    padding: 0 10px;
    border-right: 1px solid #d1d1d1;
    font-weight: 600;
}
QLabel#Stat:last-child {
    border-right: none;
}

/* ---- Inputs ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 5px 10px;
    color: #1a1a1a;
    font-size: 13px;
    min-height: 24px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { 
    border: 1px solid #0078d4; 
    background-color: #f9f9f9;
}

QPushButton#Flat {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 5px 12px;
    color: #444444;
    font-size: 12px;
}
QPushButton#Flat:hover { 
    background-color: #e5e5e5; 
    border-color: #0078d4;
    color: #1a1a1a;
}
QToolButton#Flat {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
    color: #444444;
}
QToolButton#Flat:hover { 
    background-color: #e5e5e5; 
}

QListWidget, QTreeView {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    color: #1a1a1a;
    font-size: 13px;
}
QHeaderView::section {
    background-color: #f3f3f3;
    color: #444444;
    border: none;
    padding: 6px;
    font-weight: 600;
    border-bottom: 1px solid #d1d1d1;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #ffffff;
    width: 10px;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle {
    background-color: #c1c1c1;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:hover { 
    background-color: #a0a0a0; 
}
QScrollBar::add-line, QScrollBar::sub-line { background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QTabWidget::pane {
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    background-color: #ffffff;
}
QTabBar::tab {
    background-color: #f3f3f3;
    color: #444444;
    padding: 8px 16px;
    border: 1px solid #d1d1d1;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 500;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1a1a1a;
    border-top: 2px solid #0078d4;
}
QTabBar::tab:!selected:hover { 
    color: #1a1a1a; 
    background-color: #e5e5e5;
}
QTabBar::close-button { 
    image: none; 
    subcontrol-position: right; 
    margin-left: 4px;
}

/* ---- Terminal ---- */
QPlainTextEdit#Terminal {
    background-color: #f9f9f9;
    color: #444444;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    font-family: "Cascadia Code", "Consolas", "Courier New", "Fira Code", monospace;
    font-size: 13px;
    line-height: 1.4;
}

/* ---- File Tree ---- */
QTreeView {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    color: #1a1a1a;
}
QTreeView::item:selected { 
    background-color: #add6ff; 
    color: #1a1a1a; 
}
QTreeView::item:hover { 
    background-color: #f3f3f3; 
}
QTreeView::branch { 
    background: transparent; 
}

/* ---- Radio / Check ---- */
QRadioButton { 
    color: #1a1a1a; 
    spacing: 8px; 
}
QRadioButton::indicator { 
    width: 16px; 
    height: 16px; 
    border: 1px solid #d1d1d1; 
    border-radius: 8px; 
    background: #ffffff; 
}
QRadioButton::indicator:checked { 
    background: #0078d4; 
    border: 1px solid #0078d4; 
}

QCheckBox { 
    color: #1a1a1a; 
    spacing: 8px; 
}
QCheckBox::indicator { 
    width: 16px; 
    height: 16px; 
    border: 1px solid #d1d1d1; 
    border-radius: 3px; 
    background: #ffffff; 
}
QCheckBox::indicator:checked { 
    background: #0078d4; 
    border: 1px solid #0078d4; 
}

/* ---- Dialogs ---- */
QDialog { 
    background-color: #ffffff; 
}

/* ---- List Widget ---- */
QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #f3f3f3;
    color: #1a1a1a;
}
QListWidget::item:selected { 
    background-color: #add6ff; 
    color: #1a1a1a; 
}
QListWidget::item:hover { 
    background-color: #f3f3f3; 
}

/* ---- Progress Bar ---- */
QProgressBar {
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    text-align: center;
    background-color: #f3f3f3;
    color: #444444;
    font-weight: 600;
}
QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 4px;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #d1d1d1;
    width: 3px;
}
QSplitter::handle:hover { 
    background-color: #0078d4; 
}

/* ---- Menu Bar ---- */
QMenuBar {
    background-color: #f3f3f3;
    color: #444444;
    border-bottom: 1px solid #d1d1d1;
    padding: 4px 8px;
    font-size: 12px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #e5e5e5;
    color: #1a1a1a;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 16px;
    color: #1a1a1a;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #e5e5e5;
    color: #1a1a1a;
}
QMenu::separator {
    height: 1px;
    background: #d1d1d1;
    margin: 4px 8px;
}

/* ---- Tool Tips ---- */
QToolTip {
    background-color: #f9f9f9;
    color: #1a1a1a;
    border: 1px solid #0078d4;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ---- Message Box ---- */
QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    color: #1a1a1a;
    font-size: 13px;
}

/* ---- Scroll Area ---- */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ---- Group Box ---- */
QGroupBox {
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    margin-top: 12px;
    color: #1a1a1a;
    padding-top: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #1a1a1a;
}

/* ---- Spin Box ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 5px 10px;
    color: #1a1a1a;
    min-height: 24px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #0078d4;
}

/* ---- Header View ---- */
QHeaderView::section {
    background-color: #f3f3f3;
    color: #444444;
    border: none;
    padding: 6px;
    font-weight: 600;
    border-bottom: 1px solid #d1d1d1;
}

/* ---- Tab Widget Pane ---- */
QTabWidget::pane {
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    background-color: #ffffff;
}

/* ---- Status Bar Compile Indicator ---- */
QLabel#CompileStatus {
    color: #107c10;
    font-weight: 600;
    padding: 0 8px;
}
QLabel#CompileStatus[error="true"] {
    color: #dc2626;
}
QLabel#CompileStatus[warning="true"] {
    color: #f59e0b;
}
